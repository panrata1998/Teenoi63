<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ระบบบันทึกเงินออมนักเรียน - ตี๋น้อย ป.6/3</title>
    
    <!-- Google Fonts: Prompt -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Prompt:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Prompt', '-apple-system', 'BlinkMacSystemFont', 'sans-serif'] },
                    colors: {
                        iosBlue: '#007AFF',
                        iosGreen: '#34C759',
                        iosYellow: '#FFCC00',
                        iosOrange: '#FF9500',
                        iosRed: '#FF3B30',
                        iosPurple: '#AF52DE',
                        iosTeal: '#30B0C7',
                        iosBg: '#F2F2F7',
                        iosCard: '#FFFFFF'
                    },
                    boxShadow: {
                        'app': '0 10px 30px -5px rgba(0, 0, 0, 0.08), 0 4px 12px -2px rgba(0, 0, 0, 0.04)',
                        'gold': '0 0 20px rgba(255, 204, 0, 0.4)'
                    }
                }
            }
        }
    </script>
    
    <!-- FontAwesome Icons & Canvas Confetti -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

    <style>
        body {
            font-family: 'Prompt', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: #F8FAFC;
            color: #1E293B;
            touch-action: manipulation;
        }

        .gold-glow {
            background: linear-gradient(135deg, #FFFDF0 0%, #FFF9D6 50%, #FFE066 100%);
            border: 2px solid #FFCC00;
        }

        .touch-active:active {
            transform: scale(0.97);
            opacity: 0.9;
        }

        /* Custom Scrollbars */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(0, 0, 0, 0.15);
            border-radius: 10px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(0, 0, 0, 0.3);
        }
    </style>
</head>
<body class="min-h-screen bg-slate-100 flex flex-col">

    <!-- Web App Main Header Bar -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
            
            <!-- Classroom Title Widget -->
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-iosBlue text-white rounded-2xl flex items-center justify-center text-xl font-bold shadow-md shadow-blue-200">
                    🏫
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <h1 id="headerClassName" class="font-bold text-base sm:text-lg text-slate-800 tracking-tight">ตี๋น้อย ป.6/3</h1>
                        <button id="btnEditTitle" onclick="openTitleModal()" class="text-slate-400 hover:text-iosBlue p-1 transition hidden" title="แก้ไขชื่อห้องเรียน & เป้าหมาย">
                            <i class="fa-solid fa-pen text-xs"></i>
                        </button>
                    </div>
                    <p id="headerTeacherName" class="text-xs text-slate-500 font-medium">ครูประจำชั้น: ครูปูเปี้ยว</p>
                </div>
            </div>

            <!-- Top Action Controls -->
            <div class="flex items-center gap-2 sm:gap-3">
                <!-- Open Google Sheets Direct Link Button -->
                <a id="btnOpenSheetDirect" href="#" target="_blank" class="hidden bg-emerald-50 hover:bg-emerald-100 text-emerald-700 font-bold px-3 py-1.5 rounded-xl text-xs transition border border-emerald-200 items-center gap-1.5">
                    <i class="fa-solid fa-file-excel text-emerald-600"></i>
                    <span class="hidden md:inline">เปิดตาราง Google Sheets</span>
                </a>

                <!-- Sync Status / Sheets Config Badge -->
                <button onclick="openModal('modalSheets')" class="flex items-center gap-2 bg-slate-100 hover:bg-slate-200 text-slate-700 px-3 py-1.5 rounded-xl text-xs font-bold transition">
                    <span id="sheetsStatusBadge" class="w-2.5 h-2.5 rounded-full bg-slate-300"></span>
                    <span class="hidden sm:inline">ตั้งค่า Google Sheets</span>
                </button>

                <!-- Parent Share Button -->
                <button onclick="openModal('modalShare')" class="bg-purple-50 hover:bg-purple-100 text-iosPurple font-bold px-3 py-1.5 rounded-xl text-xs transition flex items-center gap-1.5 border border-purple-200">
                    <i class="fa-solid fa-share-nodes"></i>
                    <span class="hidden sm:inline">แชร์ผู้ปกครอง</span>
                </button>

                <!-- Teacher Login / View Mode Switcher -->
                <div class="flex items-center bg-slate-200 p-1 rounded-xl">
                    <button id="btnModeView" onclick="setEditMode(false)" class="px-2.5 py-1 rounded-lg text-xs font-bold transition bg-emerald-500 text-white shadow-sm">
                        <i class="fa-solid fa-eye"></i> <span class="hidden sm:inline ml-1">ดู</span>
                    </button>
                    <button id="btnModeTeacher" onclick="handleTeacherModeClick()" class="px-2.5 py-1 rounded-lg text-xs font-bold transition text-slate-600 hover:bg-slate-100">
                        <i class="fa-solid fa-user-gear"></i> <span class="hidden sm:inline ml-1">ครู</span>
                    </button>
                </div>

                <button id="btnLogout" onclick="logoutTeacher()" class="hidden bg-red-50 hover:bg-red-100 text-iosRed font-bold px-2.5 py-1.5 rounded-xl text-xs transition border border-red-200" title="ออกจากระบบครู">
                    <i class="fa-solid fa-right-from-bracket"></i>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Content Container -->
    <main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 lg:p-8 flex flex-col gap-5">

        <!-- Top Status Banner & Goal Widget -->
        <div class="flex flex-wrap items-center justify-between gap-3 bg-white p-4 rounded-3xl border border-slate-200 shadow-sm">
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 bg-amber-100 text-amber-600 rounded-2xl flex items-center justify-center text-2xl font-bold shadow-inner shrink-0">
                    🎯
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <h2 class="text-base sm:text-lg font-bold text-slate-800">ระบบบันทึกเงินออมรายวัน</h2>
                        <span id="goalBadge" class="bg-amber-100 text-amber-800 text-xs font-extrabold px-3 py-0.5 rounded-full border border-amber-200">
                            เป้าหมาย 300 บาท
                        </span>
                    </div>
                    <p class="text-xs text-slate-500 mt-0.5">บันทึกยอดเงินออม และเชื่อมต่อตารางบันทึกใน Google Sheets</p>
                </div>
            </div>

            <!-- Date Selector & Add Student Trigger -->
            <div class="flex flex-wrap items-center gap-2 w-full sm:w-auto">
                <div class="bg-slate-100 border border-slate-200 rounded-2xl px-3 py-1.5 flex items-center gap-2 text-xs font-bold text-slate-700 flex-1 sm:flex-initial justify-between">
                    <span><i class="fa-regular fa-calendar text-iosBlue mr-1"></i> วันที่:</span>
                    <input type="date" id="inputSelectedDate" onchange="handleDateChange(this.value)" class="bg-white border border-slate-300 font-bold rounded-xl px-2.5 py-1 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-iosBlue">
                </div>

                <button id="btnAddStudentTrigger" onclick="openModal('modalAddStudent')" class="hidden bg-iosGreen hover:bg-emerald-600 text-white font-bold px-4 py-2 rounded-2xl text-xs shadow-md transition touch-active items-center gap-1.5">
                    <i class="fa-solid fa-user-plus"></i> เพิ่มนักเรียน
                </button>
            </div>
        </div>

        <!-- View Only Mode Notice Banner -->
        <div id="viewOnlyNotice" class="bg-amber-500/10 border border-amber-300 rounded-2xl p-3 flex items-center justify-between text-amber-900 text-xs shadow-sm">
            <div class="flex items-center gap-2">
                <i class="fa-solid fa-shield-halved text-amber-600 text-base"></i>
                <span>ขณะนี้คุณกำลังอยู่ใน <strong>"โหมดดูอย่างเดียว"</strong> (สำหรับผู้ปกครอง/นักเรียน)</span>
            </div>
            <button onclick="handleTeacherModeClick()" class="bg-amber-500 hover:bg-amber-600 text-white font-bold px-3 py-1.5 rounded-xl transition shadow-sm touch-active">
                เข้าสู่ระบบครู
            </button>
        </div>

        <!-- Dashboard Summary Stats Cards Grid -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3.5">
            <div class="bg-white rounded-3xl p-4 border border-slate-200 shadow-sm flex items-center gap-3.5 hover:shadow-md transition">
                <div class="w-12 h-12 rounded-2xl bg-amber-100 text-amber-600 flex items-center justify-center text-2xl shrink-0">🐷</div>
                <div>
                    <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">กระปุกใหญ่ประจำวัน</p>
                    <p class="text-xl font-extrabold text-amber-600"><span id="statDailyTotal">0</span> <span class="text-xs font-medium text-slate-500">บาท</span></p>
                </div>
            </div>

            <div class="bg-white rounded-3xl p-4 border border-slate-200 shadow-sm flex items-center gap-3.5 hover:shadow-md transition">
                <div class="w-12 h-12 rounded-2xl bg-emerald-100 text-emerald-600 flex items-center justify-center text-2xl shrink-0">🏦</div>
                <div>
                    <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">เงินออมสะสมรวม</p>
                    <p class="text-xl font-extrabold text-emerald-600"><span id="statGrandTotal">0</span> <span class="text-xs font-medium text-slate-500">บาท</span></p>
                </div>
            </div>

            <div class="bg-white rounded-3xl p-4 border border-slate-200 shadow-sm flex items-center gap-3.5 hover:shadow-md transition">
                <div class="w-12 h-12 rounded-2xl bg-purple-100 text-purple-600 flex items-center justify-center text-2xl shrink-0">👑</div>
                <div>
                    <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">ออมครบเป้าหมาย</p>
                    <p class="text-xl font-extrabold text-purple-600"><span id="statCompletedCount">0</span> <span class="text-xs font-medium text-slate-500" id="statTotalStudentsLabel">/ 0 คน</span></p>
                </div>
            </div>

            <div class="bg-white rounded-3xl p-4 border border-slate-200 shadow-sm flex items-center gap-3.5 hover:shadow-md transition">
                <div class="w-12 h-12 rounded-2xl bg-sky-100 text-sky-600 flex items-center justify-center text-2xl shrink-0">👨‍🎓</div>
                <div>
                    <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">จำนวนนักเรียน</p>
                    <p class="text-xl font-extrabold text-sky-600"><span id="statCountAll">0</span> <span class="text-xs font-medium text-slate-500">คน</span></p>
                </div>
            </div>
        </div>

        <!-- Main Interactive Content Card -->
        <div class="bg-white rounded-3xl p-4 sm:p-6 border border-slate-200 shadow-sm flex-1 flex flex-col min-h-[500px]">
            
            <!-- Toolbar: View Switcher + Daily Witness + Search Bar -->
            <div class="flex flex-wrap items-center justify-between gap-3 mb-4 shrink-0 pb-3 border-b border-slate-100">
                <div class="flex flex-wrap items-center gap-3">
                    <!-- Tab Switcher -->
                    <div class="bg-slate-100 p-1 rounded-2xl flex border border-slate-200">
                        <button onclick="switchTab('table')" id="navTable" class="px-3.5 py-1.5 rounded-xl font-bold text-xs text-iosBlue bg-white shadow-sm transition">
                            <i class="fa-solid fa-table-list mr-1"></i> ตารางบันทึก
                        </button>
                        <button onclick="switchTab('cards')" id="navCards" class="px-3.5 py-1.5 rounded-xl font-bold text-xs text-slate-600 hover:text-slate-800 transition">
                            <i class="fa-solid fa-id-card mr-1"></i> การ์ดความคืบหน้า
                        </button>
                    </div>

                    <!-- Daily Witness Selector -->
                    <div class="flex items-center gap-2 bg-slate-100 px-3 py-1.5 rounded-2xl border border-slate-200">
                        <span class="text-xs font-bold text-slate-600"><i class="fa-solid fa-handshake text-iosBlue mr-1"></i> พยานประจำวัน:</span>
                        <select id="selectWitness" onchange="handleWitnessChange(this.value)" class="bg-white border border-slate-200 text-slate-800 rounded-xl px-2.5 py-1 text-xs font-bold focus:outline-none focus:ring-2 focus:ring-iosBlue disabled:bg-slate-200">
                            <!-- Populated by JS -->
                        </select>
                    </div>
                </div>

                <!-- Search Input -->
                <div class="relative w-full sm:w-64">
                    <input type="text" id="inputSearch" oninput="handleSearch(this.value)" placeholder="ค้นหาชื่อ หรือเลขที่..." class="w-full pl-9 pr-3 py-1.5 bg-slate-100 border border-slate-200 rounded-xl text-xs font-bold focus:outline-none focus:bg-white focus:ring-2 focus:ring-iosBlue transition">
                    <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-slate-400 text-xs"></i>
                </div>
            </div>

            <!-- TAB CONTENT 1: TABLE VIEW -->
            <div id="tabContentTable" class="flex-1 overflow-x-auto rounded-2xl border border-slate-200">
                <table class="w-full text-left border-collapse min-w-[700px]">
                    <thead class="bg-slate-100 text-slate-700 text-xs font-bold uppercase tracking-wider border-b border-slate-200">
                        <tr>
                            <th class="py-3.5 px-4 text-center w-16">เลขที่</th>
                            <th class="py-3.5 px-4">ชื่อ - นามสกุล</th>
                            <th class="py-3.5 px-4 text-center min-w-[220px]">ยอดส่งเงินวันนี้ (<span id="tableHeaderDate">--</span>)</th>
                            <th class="py-3.5 px-4 text-center">ยอดออมสะสม</th>
                            <th class="py-3.5 px-4 text-center">สถานะ</th>
                            <th class="py-3.5 px-4 text-center w-28">จัดการ</th>
                        </tr>
                    </thead>
                    <tbody id="studentTableBody" class="divide-y divide-slate-100 text-xs font-medium">
                        <!-- Dynamic rows generated by JS -->
                    </tbody>
                </table>
            </div>

            <!-- TAB CONTENT 2: CARDS GRID VIEW -->
            <div id="tabContentCards" class="hidden flex-1 overflow-y-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 pt-1">
                <!-- Dynamic cards generated by JS -->
            </div>

            <!-- Bottom Table Summary Bar -->
            <div class="mt-4 pt-3 border-t border-slate-200 flex flex-wrap items-center justify-between text-xs text-slate-600 gap-2 shrink-0">
                <div class="flex items-center gap-4">
                    <span>🐷 ยอดรวมประจำวัน: <strong id="footDailyTotal" class="text-iosBlue font-bold text-sm">0</strong> บาท</span>
                    <span>🏦 สะสมรวมทั้งห้อง: <strong id="footGrandTotal" class="text-emerald-600 font-bold text-sm">0</strong> บาท</span>
                </div>
                <div class="text-slate-500 text-[11px]">
                    พยานรับส่งเงินวันนี้: <strong id="footWitnessName" class="text-slate-800">ยังไม่ได้ระบุ</strong>
                </div>
            </div>
        </div>

    </main>

    <!-- MODAL 0: TEACHER LOGIN -->
    <div id="modalLogin" class="fixed inset-0 bg-slate-900/60 backdrop-blur-md z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-3xl max-w-sm w-full p-6 shadow-app border border-slate-200">
            <div class="flex justify-between items-center mb-4">
                <h3 class="text-base font-bold text-slate-800 flex items-center gap-2">
                    <span class="w-8 h-8 rounded-xl bg-iosBlue/10 text-iosBlue flex items-center justify-center text-sm">👩‍🏫</span>
                    <span>เข้าสู่ระบบครูประจำชั้น</span>
                </h3>
                <button onclick="closeModal('modalLogin')" class="text-slate-400 hover:text-slate-600 p-1">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>
            <div class="mb-4 bg-blue-50 border border-blue-100 rounded-2xl p-3 flex items-center gap-3">
                <div class="w-10 h-10 bg-iosBlue text-white rounded-xl flex items-center justify-center text-lg font-bold shadow-sm">👩‍🏫</div>
                <div>
                    <p class="text-[10px] text-slate-500">ชื่อครูประจำชั้น:</p>
                    <p id="modalTeacherName" class="text-xs font-bold text-slate-800">ครูปูเปี้ยว</p>
                </div>
            </div>
            <form onsubmit="submitTeacherLogin(event)">
                <div class="mb-4">
                    <label class="block text-xs font-bold text-slate-600 mb-1.5">รหัสผ่าน (PIN):</label>
                    <input type="password" id="inputLoginPin" placeholder="••••••••" required class="w-full bg-slate-100 border border-slate-300 rounded-xl px-3.5 py-2.5 text-sm font-bold text-center tracking-widest focus:outline-none focus:ring-2 focus:ring-iosBlue focus:bg-white">
                    <p id="loginErrorMsg" class="text-xs text-red-500 font-bold mt-1.5 hidden text-center"></p>
                </div>
                <div class="flex gap-2">
                    <button type="button" onclick="closeModal('modalLogin')" class="w-1/3 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-600 font-bold rounded-xl text-xs touch-active">ยกเลิก</button>
                    <button type="submit" class="w-2/3 py-2.5 bg-iosBlue hover:bg-blue-600 text-white font-bold rounded-xl text-xs shadow-md touch-active">เข้าสู่ระบบ</button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL 1: ADD STUDENT -->
    <div id="modalAddStudent" class="fixed inset-0 bg-slate-900/60 backdrop-blur-md z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-3xl max-w-sm w-full p-6 shadow-app border border-slate-200">
            <h3 class="text-base font-bold text-slate-800 mb-4 flex items-center gap-2">
                <span class="w-8 h-8 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center text-sm">➕</span>
                <span>เพิ่มนักเรียนใหม่</span>
            </h3>
            <form onsubmit="submitAddStudent(event)">
                <div class="mb-3">
                    <label class="block text-xs font-bold text-slate-600 mb-1">เลขที่:</label>
                    <input type="number" id="addStudentNo" required class="w-full bg-slate-100 border border-slate-300 rounded-xl px-3 py-2 text-xs font-bold focus:outline-none focus:ring-2 focus:ring-iosGreen focus:bg-white">
                </div>
                <div class="mb-3">
                    <label class="block text-xs font-bold text-slate-600 mb-1">ชื่อ - นามสกุล:</label>
                    <input type="text" id="addStudentName" placeholder="เด็กชาย / เด็กหญิง..." required class="w-full bg-slate-100 border border-slate-300 rounded-xl px-3 py-2 text-xs font-bold focus:outline-none focus:ring-2 focus:ring-iosGreen focus:bg-white">
                </div>
                <div class="mb-5">
                    <label class="block text-xs font-bold text-slate-600 mb-1">ไอคอนสัตว์ประจำตัว:</label>
                    <select id="addStudentAvatar" class="w-full bg-slate-100 border border-slate-300 rounded-xl px-3 py-2 text-xs font-bold"></select>
                </div>
                <div class="flex gap-2">
                    <button type="button" onclick="closeModal('modalAddStudent')" class="w-1/2 py-2.5 bg-slate-100 text-slate-600 font-bold rounded-xl text-xs touch-active">ยกเลิก</button>
                    <button type="submit" class="w-1/2 py-2.5 bg-iosGreen hover:bg-emerald-600 text-white font-bold rounded-xl text-xs shadow-md touch-active">บันทึกเพิ่มนักเรียน</button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL 2: EDIT STUDENT -->
    <div id="modalEditStudent" class="fixed inset-0 bg-slate-900/60 backdrop-blur-md z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-3xl max-w-sm w-full p-6 shadow-app border border-slate-200">
            <h3 class="text-base font-bold text-slate-800 mb-4 flex items-center gap-2">
                <span class="w-8 h-8 rounded-xl bg-amber-100 text-amber-600 flex items-center justify-center text-sm">✏️</span>
                <span>แก้ไขข้อมูลนักเรียน</span>
            </h3>
            <form onsubmit="submitEditStudent(event)">
                <input type="hidden" id="editStudentId">
                <div class="mb-3">
                    <label class="block text-xs font-bold text-slate-600 mb-1">เลขที่:</label>
                    <input type="number" id="editStudentNo" required class="w-full bg-slate-100 border border-slate-300 rounded-xl px-3 py-2 text-xs font-bold">
                </div>
                <div class="mb-3">
                    <label class="block text-xs font-bold text-slate-600 mb-1">ชื่อ - นามสกุล:</label>
                    <input type="text" id="editStudentName" required class="w-full bg-slate-100 border border-slate-300 rounded-xl px-3 py-2 text-xs font-bold">
                </div>
                <div class="mb-5">
                    <label class="block text-xs font-bold text-slate-600 mb-1">ไอคอนสัตว์ประจำตัว:</label>
                    <select id="editStudentAvatar" class="w-full bg-slate-100 border border-slate-300 rounded-xl px-3 py-2 text-xs font-bold"></select>
                </div>
                <div class="flex gap-2">
                    <button type="button" onclick="closeModal('modalEditStudent')" class="w-1/2 py-2.5 bg-slate-100 text-slate-600 font-bold rounded-xl text-xs touch-active">ยกเลิก</button>
                    <button type="submit" class="w-1/2 py-2.5 bg-amber-500 hover:bg-amber-600 text-white font-bold rounded-xl text-xs shadow-md touch-active">บันทึกการแก้ไข</button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL 3: DELETE CONFIRMATION -->

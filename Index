    <script>
        // Constants & Initial Mock Data
        const AVATARS = ['🐱', '🐰', '🦁', '🦊', '🐘', '🐼', '🐯', '🐸', '🦄', '🐶', '🐻', '🐨'];
        const DEFAULT_TEACHER = 'ครูปูเปี้ยว';
        const TEACHER_PASS = '23071998';

        const INITIAL_STUDENTS = [
            { id: '1', no: 1, name: 'เด็กชาย ตี๋น้อย รักเรียน', avatar: '🐱', savings: { '2026-09-22': 60, '2026-09-21': 100, '2026-09-20': 150 } },
            { id: '2', no: 2, name: 'เด็กหญิง สดใส ใจดี', avatar: '🐰', savings: { '2026-09-22': 20, '2026-09-21': 50, '2026-09-20': 100 } },
            { id: '3', no: 3, name: 'เด็กชาย เก่งกาจ สามารถ', avatar: '🦁', savings: { '2026-09-22': 100, '2026-09-21': 100, '2026-09-20': 100 } },
            { id: '4', no: 4, name: 'เด็กหญิง มะลิ หอมหวาน', avatar: '🦊', savings: { '2026-09-22': 20, '2026-09-21': 40, '2026-09-20': 50 } },
            { id: '5', no: 5, name: 'เด็กชาย ช้างน้อย ขยันออม', avatar: '🐘', savings: { '2026-09-22': 50, '2026-09-21': 20 } },
            { id: '6', no: 6, name: 'เด็กหญิง พอเพียง มีสุข', avatar: '🐼', savings: { '2026-09-22': 100, '2026-09-21': 100, '2026-09-20': 100 } },
        ];

        // Application State
        let state = {
            className: localStorage.getItem('savings_class_name') || 'ตี๋น้อย ป.6/3',
            targetGoal: Number(localStorage.getItem('savings_target_goal')) || 300,
            selectedDate: new Date().toISOString().split('T')[0],
            isLoggedIn: localStorage.getItem('savings_is_logged_in') === 'true',
            isEditMode: localStorage.getItem('savings_is_logged_in') === 'true',
            scriptUrl: localStorage.getItem('savings_script_url') || '',
            sheetDirectUrl: localStorage.getItem('savings_sheet_direct_url') || '',
            activeTab: 'table',
            searchQuery: '',
            deletingStudentId: null,
            witnesses: JSON.parse(localStorage.getItem('savings_witnesses_data') || '{"2026-09-22": "เด็กชาย เก่งกาจ สามารถ"}'),
            students: JSON.parse(localStorage.getItem('savings_students_data') || JSON.stringify(INITIAL_STUDENTS))
        };

        // Web Audio API Sound FX
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        function playCoinSound() {
            try {
                if (audioCtx.state === 'suspended') {
                    audioCtx.resume();
                }
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(987.77, audioCtx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(1318.51, audioCtx.currentTime + 0.08);
                gain.gain.setValueAtTime(0.3, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.25);
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.start();
                osc.stop(audioCtx.currentTime + 0.25);
            } catch (e) {
                // Ignore audio blocks
            }
        }

        window.onload = function() {
            populateAvatarSelects();
            document.getElementById('inputSelectedDate').value = state.selectedDate;
            document.getElementById('inputScriptUrl').value = state.scriptUrl;
            document.getElementById('inputSheetDirectUrl').value = state.sheetDirectUrl;
            renderApp();
        };

        function saveState() {
            localStorage.setItem('savings_class_name', state.className);
            localStorage.setItem('savings_target_goal', state.targetGoal);
            localStorage.setItem('savings_script_url', state.scriptUrl);
            localStorage.setItem('savings_sheet_direct_url', state.sheetDirectUrl);
            localStorage.setItem('savings_witnesses_data', JSON.stringify(state.witnesses));
            localStorage.setItem('savings_students_data', JSON.stringify(state.students));
        }

        function saveScriptUrl() {
            const url = document.getElementById('inputScriptUrl').value.trim();
            state.scriptUrl = url;
            saveState();
            const txt = document.getElementById('scriptUrlSavedText');
            txt.classList.remove('hidden');
            setTimeout(() => txt.classList.add('hidden'), 3000);
            renderApp();
        }

        function saveSheetDirectUrl() {
            const url = document.getElementById('inputSheetDirectUrl').value.trim();
            state.sheetDirectUrl = url;
            saveState();
            renderApp();
        }

        function clearScriptUrl() {
            state.scriptUrl = '';
            document.getElementById('inputScriptUrl').value = '';
            saveState();
            const txt = document.getElementById('scriptUrlClearedText');
            txt.classList.remove('hidden');
            setTimeout(() => txt.classList.add('hidden'), 3000);
            renderApp();
        }

        function sendToGoogleSheets(studentName, amount) {
            if (!state.scriptUrl) return;
            const witness = state.witnesses[state.selectedDate] || 'ไม่ได้ระบุ';
            fetch(state.scriptUrl, {
                method: 'POST',
                mode: 'no-cors',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    date: state.selectedDate,
                    studentName: studentName,
                    amount: amount,
                    witness: witness
                })
            }).catch(e => console.log('Sheets sync error:', e));
        }

        function populateAvatarSelects() {
            const addSel = document.getElementById('addStudentAvatar');
            const editSel = document.getElementById('editStudentAvatar');
            const options = AVATARS.map(a => `<option value="${a}">${a} สัตว์ประจำเป็นตัว</option>`).join('');
            addSel.innerHTML = options;
            editSel.innerHTML = options;
        }

        function renderApp() {
            // Header elements
            document.getElementById('headerClassName').innerText = state.className;
            document.getElementById('headerTeacherName').innerText = `ครูประจำชั้น: ${DEFAULT_TEACHER}`;
            document.getElementById('modalTeacherName').innerText = DEFAULT_TEACHER;
            document.getElementById('goalBadge').innerText = `เป้าหมาย ${state.targetGoal} บาท`;

            // Direct Sheets Link Button State
            const btnOpenSheetDirect = document.getElementById('btnOpenSheetDirect');
            if (state.sheetDirectUrl) {
                btnOpenSheetDirect.href = state.sheetDirectUrl;
                btnOpenSheetDirect.classList.remove('hidden');
                btnOpenSheetDirect.classList.add('flex');
            } else {
                btnOpenSheetDirect.classList.add('hidden');
                btnOpenSheetDirect.classList.remove('flex');
            }

            // Google Sheets Status Badge
            const sheetsBadge = document.getElementById('sheetsStatusBadge');
            if (state.scriptUrl) {
                sheetsBadge.className = "w-2.5 h-2.5 rounded-full bg-emerald-500 shadow-sm";
            } else {
                sheetsBadge.className = "w-2.5 h-2.5 rounded-full bg-slate-300";
            }

            // Controls Visibility by Mode
            const btnEditTitle = document.getElementById('btnEditTitle');
            const btnLogout = document.getElementById('btnLogout');
            const btnModeTeacher = document.getElementById('btnModeTeacher');
            const btnModeView = document.getElementById('btnModeView');
            const viewOnlyNotice = document.getElementById('viewOnlyNotice');
            const btnAddStudentTrigger = document.getElementById('btnAddStudentTrigger');

            if (state.isEditMode) {
                btnEditTitle.classList.remove('hidden');
                btnLogout.classList.remove('hidden');
                viewOnlyNotice.classList.add('hidden');
                btnAddStudentTrigger.classList.remove('hidden');
                btnAddStudentTrigger.classList.add('flex');

                btnModeTeacher.className = "px-2.5 py-1 rounded-lg text-xs font-bold transition bg-iosBlue text-white shadow-sm";
                btnModeView.className = "px-2.5 py-1 rounded-lg text-xs font-bold transition text-slate-600 hover:bg-slate-100";
            } else {
                btnEditTitle.classList.add('hidden');
                btnLogout.classList.add('hidden');
                viewOnlyNotice.classList.remove('hidden');
                btnAddStudentTrigger.classList.add('hidden');
                btnAddStudentTrigger.classList.remove('flex');

                btnModeTeacher.className = "px-2.5 py-1 rounded-lg text-xs font-bold transition text-slate-600 hover:bg-slate-100";
                btnModeView.className = "px-2.5 py-1 rounded-lg text-xs font-bold transition bg-emerald-500 text-white shadow-sm";
            }

            // Calculate Totals
            let grandTotal = 0;
            let dailyTotal = 0;
            let completedCount = 0;

            const filteredStudents = state.students.filter(s => 
                s.name.toLowerCase().includes(state.searchQuery.toLowerCase()) || 
                s.no.toString().includes(state.searchQuery)
            );

            state.students.forEach(s => {
                const total = Object.values(s.savings || {}).reduce((a, b) => a + (Number(b) || 0), 0);
                grandTotal += total;
                if (total >= state.targetGoal) completedCount++;
                dailyTotal += Number(s.savings?.[state.selectedDate]) || 0;
            });

            document.getElementById('statDailyTotal').innerText = dailyTotal.toLocaleString();
            document.getElementById('statGrandTotal').innerText = grandTotal.toLocaleString();
            document.getElementById('statCompletedCount').innerText = completedCount;
            document.getElementById('statTotalStudentsLabel').innerText = `/ ${state.students.length} คน`;
            document.getElementById('statCountAll').innerText = state.students.length;

            document.getElementById('tableHeaderDate').innerText = state.selectedDate;
            document.getElementById('footDailyTotal').innerText = dailyTotal.toLocaleString();
            document.getElementById('footGrandTotal').innerText = grandTotal.toLocaleString();

            const currentWitness = state.witnesses[state.selectedDate] || 'ยังไม่ได้ระบุ';
            document.getElementById('footWitnessName').innerText = currentWitness;

            // Render witness options
            const selectWitness = document.getElementById('selectWitness');
            selectWitness.disabled = !state.isEditMode;
            selectWitness.innerHTML = '<option value="">-- เลือกนักเรียนพยาน --</option>' +
                state.students.map(s => `<option value="${s.name}" ${currentWitness === s.name ? 'selected' : ''}>เลขที่ ${s.no} - ${s.name}</option>`).join('');

            renderTable(filteredStudents);
            renderCards(filteredStudents);
        }

        function renderTable(students) {
            const tbody = document.getElementById('studentTableBody');
            if (students.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" class="py-12 text-center text-slate-400 font-medium">ไม่พบข้อมูลนักเรียน</td></tr>`;
                return;
            }

            tbody.innerHTML = students.map(s => {
                const total = Object.values(s.savings || {}).reduce((a, b) => a + (Number(b) || 0), 0);
                const isCompleted = total >= state.targetGoal;
                const todaySavings = s.savings?.[state.selectedDate] ?? '';

                return `
                    <tr class="hover:bg-slate-50 transition ${isCompleted ? 'bg-amber-50/30' : ''}">
                        <td class="py-3 px-4 text-center font-bold text-slate-500">${s.no}</td>
                        <td class="py-3 px-4">
                            <div class="flex items-center gap-2.5">
                                <span class="text-xl p-1.5 bg-slate-100 rounded-2xl shadow-sm">${s.avatar}</span>
                                <span class="font-bold text-slate-800">${s.name}</span>
                            </div>
                        </td>
                        <td class="py-3 px-4 text-center">
                            <div class="flex items-center justify-center gap-1.5">
                                <input type="number" min="0" value="${todaySavings}" 
                                    onchange="handleSavingsChange('${s.id}', this.value)"
                                    ${!state.isEditMode ? 'disabled' : ''} 
                                    placeholder="0" 
                                    class="w-20 text-center font-bold bg-slate-100 border border-slate-200 rounded-xl px-2 py-1.5 text-xs focus:outline-none focus:bg-white focus:ring-2 focus:ring-iosBlue disabled:bg-slate-100 disabled:text-slate-600">
                                ${state.isEditMode ? `
                                    <div class="flex gap-1">
                                        <button onclick="handleQuickAdd('${s.id}', 10)" class="px-2 py-1 text-[11px] font-bold bg-amber-100 text-amber-800 rounded-lg hover:bg-amber-200 touch-active">+10</button>
                                        <button onclick="handleQuickAdd('${s.id}', 20)" class="px-2 py-1 text-[11px] font-bold bg-blue-100 text-iosBlue rounded-lg hover:bg-blue-200 touch-active">+20</button>
                                        <button onclick="handleQuickAdd('${s.id}', 50)" class="px-2 py-1 text-[11px] font-bold bg-emerald-100 text-emerald-800 rounded-lg hover:bg-emerald-200 touch-active">+50</button>
                                    </div>
                                ` : ''}
                            </div>
                        </td>
                        <td class="py-3 px-4 text-center font-bold text-slate-800">
                            ${total.toLocaleString()} <span class="text-[10px] font-normal text-slate-400">บาท</span>
                        </td>
                        <td class="py-3 px-4 text-center">
                            ${isCompleted ? 
                                `<span class="inline-flex items-center gap-1 bg-amber-400 text-slate-900 font-extrabold px-3 py-0.5 rounded-full text-[10px] shadow-sm">👑 ออมครบแล้ว 🏆</span>` : 
                                `<span class="inline-flex items-center gap-1 bg-slate-100 text-slate-600 font-semibold px-2.5 py-0.5 rounded-full text-[10px]">ขาดอีก ${state.targetGoal - total} บ.</span>`
                            }
                        </td>
                        <td class="py-3 px-4 text-center">
                            <div class="flex items-center justify-center gap-1">
                                <button onclick="openHistoryModal('${s.id}')" class="p-2 text-iosBlue hover:bg-blue-50 rounded-xl transition touch-active" title="ดูประวัติการออม">
                                    <i class="fa-solid fa-clock-rotate-left text-sm"></i>
                                </button>
                                ${state.isEditMode ? `
                                    <button onclick="openEditStudentModal('${s.id}')" class="p-2 text-amber-600 hover:bg-amber-50 rounded-xl transition touch-active" title="แก้ไขนักเรียน">
                                        <i class="fa-solid fa-pen text-sm"></i>
                                    </button>
                                    <button onclick="openDeleteStudentModal('${s.id}')" class="p-2 text-iosRed hover:bg-red-50 rounded-xl transition touch-active" title="ลบนักเรียน">
                                        <i class="fa-solid fa-trash-can text-sm"></i>
                                    </button>
                                ` : ''}
                            </div>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        function renderCards(students) {
            const cardsContainer = document.getElementById('tabContentCards');
            if (students.length === 0) {
                cardsContainer.innerHTML = `<div class="col-span-3 py-12 text-center text-slate-400 font-medium">ไม่พบข้อมูลนักเรียน</div>`;
                return;
            }

            cardsContainer.innerHTML = students.map(s => {
                const total = Object.values(s.savings || {}).reduce((a, b) => a + (Number(b) || 0), 0);
                const isCompleted = total >= state.targetGoal;
                const percent = Math.min(100, Math.round((total / state.targetGoal) * 100));

                return `
                    <div class="bg-white rounded-3xl p-4 border transition-all duration-200 shadow-sm hover:shadow-md ${isCompleted ? 'gold-glow' : 'border-slate-200'}">
                        ${isCompleted ? `<div class="bg-amber-400 text-slate-900 text-[10px] font-black px-2.5 py-0.5 rounded-full shadow-sm w-fit mb-2">👑 ออมครบ ${state.targetGoal} บาทแล้ว!</div>` : ''}
                        <div class="flex items-center gap-3 mb-3">
                            <div class="w-12 h-12 bg-slate-100 rounded-2xl border border-slate-200 flex items-center justify-center text-2xl shadow-sm">${s.avatar}</div>
                            <div>
                                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">เลขที่ ${s.no}</span>
                                <h3 class="font-bold text-slate-800 text-sm leading-tight">${s.name}</h3>
                            </div>
                        </div>
                        <div>
                            <div class="flex justify-between text-[11px] font-bold mb-1">
                                <span class="text-slate-500">ความคืบหน้า</span>
                                <span class="${isCompleted ? 'text-amber-800 font-black' : 'text-iosBlue'}">${percent}%</span>
                            </div>
                            <div class="w-full bg-slate-100 h-3 rounded-full overflow-hidden p-0.5 border border-slate-200">
                                <div class="h-full rounded-full transition-all duration-300 ${isCompleted ? 'bg-gradient-to-r from-amber-400 to-yellow-500' : 'bg-iosBlue'}" style="width: ${percent}%"></div>
                            </div>
                            <div class="flex justify-between items-center mt-3 text-xs">
                                <span class="text-slate-500">สะสมแล้ว: <strong class="text-slate-800 font-bold">${total.toLocaleString()}</strong> บาท</span>
                                <button onclick="openHistoryModal('${s.id}')" class="text-iosBlue hover:underline font-bold text-[11px]">ดูประวัติ →</button>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function setEditMode(enable) {
            state.isEditMode = enable;
            renderApp();
        }

        function handleTeacherModeClick() {
            if (state.isLoggedIn) {
                setEditMode(true);
            } else {
                openModal('modalLogin');
            }
        }

        function submitTeacherLogin(e) {
            e.preventDefault();
            const pin = document.getElementById('inputLoginPin').value;
            const err = document.getElementById('loginErrorMsg');
            if (pin === TEACHER_PASS) {
                state.isLoggedIn = true;
                state.isEditMode = true;
                localStorage.setItem('savings_is_logged_in', 'true');
                err.classList.add('hidden');
                document.getElementById('inputLoginPin').value = '';
                closeModal('modalLogin');
                renderApp();
            } else {
                err.innerText = 'รหัสผ่านไม่ถูกต้อง กรุณาลองใหม่อีกครั้ง';
                err.classList.remove('hidden');
            }
        }

        function logoutTeacher() {
            state.isLoggedIn = false;
            state.isEditMode = false;
            localStorage.setItem('savings_is_logged_in', 'false');
            renderApp();
        }

        function handleSavingsChange(studentId, val) {
            if (!state.isEditMode) return;
            const num = Math.max(0, Number(val) || 0);
            const student = state.students.find(s => s.id === studentId);
            if (!student) return;

            const prevTotal = Object.values(student.savings || {}).reduce((a, b) => a + (Number(b) || 0), 0);
            if (!student.savings) student.savings = {};

            if (num === 0) {
                delete student.savings[state.selectedDate];
            } else {
                student.savings[state.selectedDate] = num;
                playCoinSound();
                sendToGoogleSheets(student.name, num);
            }

            const newTotal = Object.values(student.savings).reduce((a, b) => a + (Number(b) || 0), 0);
            if (prevTotal < state.targetGoal && newTotal >= state.targetGoal && typeof confetti === 'function') {
                confetti({ particleCount: 120, spread: 80, origin: { y: 0.5 } });
            }

            saveState();
            renderApp();
        }

        function handleQuickAdd(studentId, addAmt) {
            const student = state.students.find(s => s.id === studentId);
            const curr = Number(student?.savings?.[state.selectedDate]) || 0;
            handleSavingsChange(studentId, curr + addAmt);
        }

        function handleDateChange(dateVal) {
            state.selectedDate = dateVal;
            renderApp();
        }

        function handleWitnessChange(witnessName) {
            state.witnesses[state.selectedDate] = witnessName;
            saveState();
            renderApp();
        }

        function handleSearch(q) {
            state.searchQuery = q;
            renderApp();
        }

        function switchTab(tab) {
            state.activeTab = tab;
            const navTable = document.getElementById('navTable');
            const navCards = document.getElementById('navCards');
            const tabContentTable = document.getElementById('tabContentTable');
            const tabContentCards = document.getElementById('tabContentCards');

            if (tab === 'table') {
                navTable.className = "px-3.5 py-1.5 rounded-xl font-bold text-xs text-iosBlue bg-white shadow-sm transition";
                navCards.className = "px-3.5 py-1.5 rounded-xl font-bold text-xs text-slate-600 hover:text-slate-800 transition";
                tabContentTable.classList.remove('hidden');
                tabContentCards.classList.add('hidden');
            } else {
                navCards.className = "px-3.5 py-1.5 rounded-xl font-bold text-xs text-iosPurple bg-white shadow-sm transition";
                navTable.className = "px-3.5 py-1.5 rounded-xl font-bold text-xs text-slate-600 hover:text-slate-800 transition";
                tabContentCards.classList.remove('hidden');
                tabContentTable.classList.add('hidden');
            }
        }

        // Student Management Modals
        function submitAddStudent(e) {
            e.preventDefault();
            const no = Number(document.getElementById('addStudentNo').value);
            const name = document.getElementById('addStudentName').value.trim();
            const avatar = document.getElementById('addStudentAvatar').value;

            state.students.push({ id: Date.now().toString(), no, name, avatar, savings: {} });
            state.students.sort((a, b) => a.no - b.no);
            saveState();
            closeModal('modalAddStudent');
            renderApp();
        }

        function openEditStudentModal(id) {
            const student = state.students.find(s => s.id === id);
            if (!student) return;
            document.getElementById('editStudentId').value = student.id;
            document.getElementById('editStudentNo').value = student.no;
            document.getElementById('editStudentName').value = student.name;
            document.getElementById('editStudentAvatar').value = student.avatar;
            openModal('modalEditStudent');
        }

        function submitEditStudent(e) {
            e.preventDefault();
            const id = document.getElementById('editStudentId').value;
            const student = state.students.find(s => s.id === id);
            if (student) {
                student.no = Number(document.getElementById('editStudentNo').value);
                student.name = document.getElementById('editStudentName').value.trim();
                student.avatar = document.getElementById('editStudentAvatar').value;
                state.students.sort((a, b) => a.no - b.no);
                saveState();
                renderApp();
            }
            closeModal('modalEditStudent');
        }

        function openDeleteStudentModal(id) {
            const student = state.students.find(s => s.id === id);
            if (!student) return;
            state.deletingStudentId = id;
            document.getElementById('deleteStudentText').innerText = `คุณต้องการลบ "${student.name}" (เลขที่ ${student.no}) หรือไม่?`;
            openModal('modalDeleteStudent');
        }

        function confirmDeleteStudent() {
            if (state.deletingStudentId) {
                state.students = state.students.filter(s => s.id !== state.deletingStudentId);
                state.deletingStudentId = null;
                saveState();
                renderApp();
            }
            closeModal('modalDeleteStudent');
        }

        // Student History Modal with Witness Details
        function openHistoryModal(id) {
            const student = state.students.find(s => s.id === id);
            if (!student) return;

            document.getElementById('historyStudentAvatar').innerText = student.avatar;
            document.getElementById('historyStudentName').innerText = student.name;
            document.getElementById('historyStudentNo').innerText = `เลขที่ ${student.no}`;

            const total = Object.values(student.savings || {}).reduce((a, b) => a + (Number(b) || 0), 0);
            document.getElementById('historyStudentTotal').innerText = total.toLocaleString();

            const container = document.getElementById('historyListContainer');
            const entries = Object.entries(student.savings || {}).sort((a, b) => new Date(b[0]) - new Date(a[0]));

            if (entries.length === 0) {
                container.innerHTML = `<p class="text-center text-slate-400 py-4 text-xs font-medium">ยังไม่มีรายการบันทึกเงินออม</p>`;
            } else {
                container.innerHTML = entries.map(([date, amount]) => `
                    <div class="flex justify-between items-center bg-slate-50 p-3 rounded-2xl border border-slate-200 text-xs">
                        <div>
                            <div class="font-bold text-slate-700">📅 ${date}</div>
                            <div class="text-[10px] text-slate-500 mt-0.5">🤝 พยาน: <strong class="text-slate-700">${state.witnesses[date] || 'ไม่ได้ระบุ'}</strong></div>
                        </div>
                        <span class="font-bold text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-xl border border-emerald-200">+${amount} บาท</span>
                    </div>
                `).join('');
            }

            openModal('modalHistory');
        }

        // Classroom Title Modal
        function openTitleModal() {
            document.getElementById('inputClassName').value = state.className;
            document.getElementById('inputTargetGoal').value = state.targetGoal;
            openModal('modalTitle');
        }

        function submitTitleEdit(e) {
            e.preventDefault();
            state.className = document.getElementById('inputClassName').value.trim();
            state.targetGoal = Number(document.getElementById('inputTargetGoal').value) || 300;
            saveState();
            closeModal('modalTitle');
            renderApp();
        }

        function copyShareLink() {
            document.execCommand('copy');
            const successText = document.getElementById('copyShareSuccess');
            successText.classList.remove('hidden');
            setTimeout(() => successText.classList.add('hidden'), 2500);
        }

        function copyAppsScriptCode() {
            const codeText = document.getElementById('appsScriptCodeBlock').innerText;
            const tempTextArea = document.createElement('textarea');
            tempTextArea.value = codeText;
            document.body.appendChild(tempTextArea);
            tempTextArea.select();
            document.execCommand('copy');
            document.body.removeChild(tempTextArea);

            const btnText = document.getElementById('copyScriptBtnText');
            if (btnText) {
                btnText.innerText = 'คัดลอกแล้ว! ✨';
                setTimeout(() => {
                    btnText.innerText = 'คัดลอกโค้ด';
                }, 2000);
            }
        }

        // Generic Modal Helpers
        function openModal(id) {
            document.getElementById(id).classList.remove('hidden');
        }
        function closeModal(id) {
            document.getElementById(id).classList.add('hidden');
        }
    </script>
</body>
</html>
